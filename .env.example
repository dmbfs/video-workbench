# 复制为 .env 后按需修改。应用本体不强制依赖任何变量，全部留空也能跑（Mock 模式）。
# 注意：模型 API key 不走环境变量——在应用「设置页」录入，仅存本地 SQLite，绝不上传。

# ---- 服务 ----
# 后端监听端口（默认 8787；web 开发服务器 5173 已配置反代）
# PORT=8787

# ---- 生成与导出 ----
# 生成清晰度档位（默认 1080p，按 provider 能力自动收紧；可设 720p 省成本）
# VIDSTITCH_RESOLUTION=1080p
# TTS 旁白模型与音色（默认走 MiniMax 网关缺省值）
# VIDSTITCH_TTS_MODEL=
# VIDSTITCH_TTS_VOICE=

# ---- 生成循环硬边界（防失控计费）----
# 单段轮询超时（默认 10 分钟，超时不再重试）
# VIDSTITCH_POLL_TIMEOUT_MS=600000
# 单项目付费任务上限（默认 30 次）
# VIDSTITCH_MAX_CALLS_PER_PROJECT=30
# 连续失败熔断阈值（默认连续 3 段终态失败即熔断该项目排队任务）
# VIDSTITCH_BREAKER_FAILURE_THRESHOLD=3
# 轮询间隔（默认 1500ms）
# VIDSTITCH_POLL_INTERVAL_MS=1500

# ---- 开发期联网调研（可选）----
# 仅开发/写文档时用 Firecrawl 抓资料，运行本应用不依赖
# FIRECRAWL_API_KEY=
